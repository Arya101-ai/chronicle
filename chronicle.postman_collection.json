{
  "info": {
    "_postman_id": "eba6f38c-ae0b-4fbb-ae44-78405c6a9c66",
    "name": "Chronicle API - login, session, chat",
    "description": "Three-step flow for a TestMu AI Endpoint Profile: 1) login (suite setup), 2) create session (scenario setup), 3) chat.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "username",
      "value": "tester"
    },
    {
      "key": "password",
      "value": "chronicle-test"
    },
    {
      "key": "message",
      "value": "When did the French Revolution begin?"
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "session_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Login (suite setup)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.test('login ok', () => pm.response.code === 200 && !!j.access_token);",
              "pm.collectionVariables.set('access_token', j.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "2. Create session (scenario setup)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.test('session created', () => pm.response.code === 201 && !!j.session_id);",
              "pm.collectionVariables.set('session_id', j.session_id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/sessions",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "sessions"
          ]
        }
      }
    },
    {
      "name": "3. Chat",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "pm.test('chat ok', () => pm.response.code === 200 && typeof j.response === 'string');"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"message\": \"{{message}}\",\n  \"session_id\": \"{{session_id}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/chat",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "chat"
          ]
        }
      }
    }
  ]
}